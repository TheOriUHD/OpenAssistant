#pragma once

// Copy to secrets.h (git-ignored) and fill in.

// 2.4 GHz network (the ESP32-C6 has no 5 GHz radio)
#define WIFI_SSID      "your-wifi"
#define WIFI_PASSWORD  "your-password"

// Home Assistant on the local network, plain HTTP/WebSocket (no TLS: it costs
// ~40 KB of RAM this board doesn't have to spare).
#define HA_HOST        "192.168.1.10"
#define HA_PORT        8123

// Profile (bottom left in HA) -> Security -> Long-lived access tokens -> Create token
#define HA_TOKEN       "paste-token-here"

// Assist pipeline to run (Settings -> Voice assistants; the ID is in the URL
// when editing one). It needs a wake word engine and a speech-to-text engine.
#define HA_PIPELINE_ID "pipeline-id"

// MQTT broker HA uses (the Mosquitto add-on accepts HA users) for device discovery
#define MQTT_URI       "mqtt://192.168.1.10:1883"
#define MQTT_USER      "voicepanel"
#define MQTT_PASSWORD  "password"
